---
import Layout from '../../layouts/Layout.astro';
import ProductPage from '../../components/ProductPage.astro';
import { en } from '../../i18n/openfuse';
import '../../styles/global.css';
---

<Layout
  title={en.title}
  description={en.description}
  lang="en"
  product="openfuse"
  ogImage={en.og.image}
