<script is:inline>
(function() {
  // Reveal hero loop-moment lines sequentially when scrolled into view.
  var loopMoment = document.querySelector('.loop-moment');
  if (loopMoment) {
    var loopLines = loopMoment.querySelectorAll('.loop-line');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      loopMoment.classList.add('revealed');
    } else {
      loopLines.forEach(function(line, idx) {
        line.style.transitionDelay = (120 * idx) + 'ms';
      });
      var loopObserver = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          loopMoment.classList.add('revealed');
          loopObserver.disconnect();
        }
      }, { threshold: 0.25 });
      loopObserver.observe(loopMoment);
    }
  }

  // Screenshot → Video → Screenshot loop, triggered when scrolled into view.
  document.querySelectorAll('.showcase-media-stack').forEach(function(stack) {
    var video = stack.querySelector('.showcase-video');
    if (!video) return;
    var started = false;
    // 6s hold lets a reader take in the static screenshot (context-
    // window breakdown, waterfall, KPI strip) before the live canvas
    // animation pulls focus. 3s was too tight for the detail view.
    var stillHoldMs = 6000;
    function cycle() {
      setTimeout(function() {
        video.currentTime = 0;
        video.play();
        video.classList.add('active');
        video.addEventListener('ended', function onEnd() {
          video.removeEventListener('ended', onEnd);
          video.classList.remove('active');
          cycle();
        });
      }, stillHoldMs);
    }
    var observer = new IntersectionObserver(function(entries) {
      if (entries[0].isIntersecting && !started) {
        started = true;
        observer.disconnect();
        cycle();
      }
    }, { threshold: 0.3 });
    observer.observe(stack);
  });

  // Typing effect for hero hook — cycles through hooks[] indefinitely.
  // Each cycle: type → hold → erase → next. Cursor stays visible (no
  // fade-out) because the cycle never finishes. prefers-reduced-motion
  // skips the animation and shows the first hook statically.
  var hookText = document.querySelector('.hook-text');
  if (hookText) {
    var hooks;
    try { hooks = JSON.parse(hookText.getAttribute('data-hooks') || '[]'); } catch (e) { hooks = []; }
    if (!hooks.length) { hooks = [hookText.textContent || '']; }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hookText.textContent = hooks[0];
    } else {
      var typeSpeed = 60;
      var eraseSpeed = 25;
      var holdAfterType = 3500;
      var holdBeforeErase = 400;
      var initialDelay = 800;
      var idx = 0;
      hookText.textContent = '';

      function typeNext() {
        var text = hooks[idx];
        var i = 0;
        var typeId = setInterval(function () {
          hookText.textContent = text.slice(0, ++i);
          if (i >= text.length) {
            clearInterval(typeId);
            setTimeout(function () {
              eraseAndAdvance(text);
            }, holdAfterType);
          }
        }, typeSpeed);
      }

      function eraseAndAdvance(text) {
        var len = text.length;
        var eraseId = setInterval(function () {
          len--;
          hookText.textContent = text.slice(0, len);
          if (len <= 0) {
            clearInterval(eraseId);
            idx = (idx + 1) % hooks.length;
            setTimeout(typeNext, holdBeforeErase);
          }
        }, eraseSpeed);
      }

      setTimeout(typeNext, initialDelay);
    }
  }
})();
</script>
