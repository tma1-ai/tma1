---
import Lightbox from './Lightbox.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import type { T } from '../i18n/ui';

interface Props {
  t: T;
}

const { t } = Astro.props;
const lang = t.lang;
const onboardingCmd = 'Read https://tma1.ai/SKILL.md and follow the instructions to install or upgrade TMA1 for your AI agent';
const curlCmd = 'curl -fsSL https://tma1.ai/install.sh | bash';
const psCmd = 'irm https://tma1.ai/install.ps1 | iex';

// Showcase row layouts. First two rows are custom (loop scenarios, peer terminal);
// remaining rows are standard screenshot showcases.
type ShowcaseEntry =
  | { kind: 'loop' }
  | { kind: 'peer' }
  | { kind: 'image'; dark: string; light: string; w: number; h: number; video?: string };

const navLinks = [
  { href: '#features', label: t.nav.features },
  { href: '#how-it-works', label: t.nav.how },
  { href: '#security', label: t.nav.security },
];

const footerLinks = [
  { href: 'https://github.com/tma1-ai/tma1', label: 'GitHub' },
  { href: 'https://github.com/tma1-ai/tma1/blob/main/LICENSE', label: 'Apache-2.0' },
  { href: '#security', label: t.nav.security },
];

const showcase: ShowcaseEntry[] = [
  { kind: 'loop' },                                                                                                                                              // 01 closes-loop
  { kind: 'peer' },                                                                                                                                              // 02 cross-agent peer
  { kind: 'image', dark: '/screenshots/anomaly-dark.webp',  light: '/screenshots/anomaly-light.webp',  w: 3024, h: 1706 },                                      // 03 anomalies
  { kind: 'image', dark: '/screenshots/sessions-dark.webp', light: '/screenshots/sessions-light.webp', w: 3006, h: 1722, video: '/screenshots/session-live.mp4' }, // 04 sessions
  { kind: 'image', dark: '/screenshots/tools-dark.webp',    light: '/screenshots/tools-light.webp',    w: 3010, h: 1706 },                                      // 05 tools
  { kind: 'image', dark: '/screenshots/cost-dark.webp',     light: '/screenshots/cost-light.webp',     w: 3024, h: 1704 },                                      // 06 cost
  { kind: 'image', dark: '/screenshots/security-dark.webp', light: '/screenshots/security-light.webp', w: 3010, h: 1154 },                                      // 07 security
];
// 08 search → renders as feature-standalone below the showcase rows.
---

<SiteHeader lang={lang} product="tma1" links={navLinks} />

<div class="container">
  <section class="hero">
    <p class="eyebrow">TMA1</p>
    <h1>
      {t.hero.h1_1}
      <span class="muted">{t.hero.h1_2}</span>
    </h1>
    <p class="subtitle" set:html={t.hero.subtitle} />
    <p class="hook"><span class="hook-text" data-hooks={JSON.stringify(t.hero.hooks)}>{t.hero.hooks[0]}</span><span class="hook-cursor">_</span></p>

    <div class="loop-moment terminal">
      <div class="terminal-header">
        <span class="dot red"></span>
        <span class="dot yellow"></span>
        <span class="dot green"></span>
        <span class="terminal-title">{t.hero.loop_moment.title_bar}</span>
      </div>
      <div class="loop-moment-body">
        {t.hero.loop_moment.lines.map(line => (
          line.kind === 'blank' ? (
            <div class="loop-line"><span>&nbsp;</span></div>
          ) : line.kind === 'comment' ? (
            <div class="loop-line loop-comment"><span class="prompt">$</span><span># {line.text}</span></div>
          ) : line.kind === 'cmd' ? (
            <div class="loop-line"><span class="prompt">$</span><span>{line.text}</span></div>
          ) : (
            <div class="loop-line loop-tma1"><span class="tma1-tag">[tma1]</span><span>{line.text}</span></div>
          )
        ))}
      </div>
    </div>

    <div class="onboarding-card">
      <p class="onboarding-label">{t.onboarding.label}</p>
      <div class="onboarding-body">
        <p class="onboarding-text">Read <a href="https://tma1.ai/SKILL.md">https://tma1.ai/SKILL.md</a> and follow the instructions to install or upgrade TMA1 for your AI agent</p>
        <button class="copy-btn"
          onclick={`navigator.clipboard.writeText('${onboardingCmd}').then(()=>{this.textContent='${t.ui.copied}';setTimeout(()=>this.textContent='${t.ui.copy}',1500)})`}>
          {t.ui.copy}
        </button>
      </div>
    </div>

    <details class="manual-install">
      <summary>{t.onboarding.manual}</summary>
      <div class="terminal install-terminal">
        <div class="terminal-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="terminal-title">terminal</span>
        </div>
        <div class="terminal-body">
          <div class="line comment"># macOS / Linux</div>
          <div class="line">
            <span class="prompt">$</span>
            <span class="cmd">{curlCmd}</span>
          </div>
          <div class="line">&nbsp;</div>
          <div class="line comment"># Windows (PowerShell)</div>
          <div class="line">
            <span class="prompt">&gt;</span>
            <span class="cmd">{psCmd}</span>
          </div>
        </div>
      </div>
    </details>

    <div class="highlights">
      {t.highlights.map(h => (
        <div class="highlight-card">
          <h3>{h.title}</h3>
          <p set:html={h.desc} />
        </div>
      ))}
    </div>
  </section>

  <section id="features" class="features">
    <p class="section-kicker">{t.features.kicker}</p>
    <h2 class="section-title">{t.features.title}</h2>
    <p class="section-desc">{t.features.desc}</p>
    <div class="showcase">
      {t.features.cards.slice(0, 7).map((c, i) => {
        const entry = showcase[i];
        return (
          <div class={`showcase-row showcase-row--${entry.kind}${i % 2 === 1 ? ' flip' : ''}`}>
            <div class="showcase-text">
              <div class="feature-icon">{c.num}</div>
              <h3>{c.title}</h3>
              <p set:html={c.desc} />
              {entry.kind === 'loop' && (
                <div class="loop-preview showcase-frame">
                  <div class="browser-chrome">
                    <span class="dot red"></span>
                    <span class="dot yellow"></span>
                    <span class="dot green"></span>
                    <span class="browser-url">localhost:14318</span>
                  </div>
                  <div class="showcase-frame__body">
                    <img class="theme-img"
                      data-dark-src="/screenshots/performance-dark.webp"
                      data-light-src="/screenshots/performance-light.webp"
                      src="/screenshots/performance-dark.webp"
                      alt="TMA1 dashboard — Performance tab preview"
                      loading="lazy" width={2586} height={1700} />
                  </div>
                </div>
              )}
            </div>
            <div class="showcase-image">
              {entry.kind === 'loop' ? (
                <div class="loop-scenarios" aria-label="Anomaly scenarios">
                  <p class="loop-scenarios-intro" set:html={t.loop_scenarios.intro} />
                  <div class="loop-scenarios-grid">
                    {t.loop_scenarios.items.map(item => (
                      <article class="scenario-card">
                        <div class="scenario-head">
                          <span class="scenario-kind">{item.kind}</span>
                          <span class={`scenario-severity scenario-severity--${item.severity.toLowerCase()}`}>{item.severity}</span>
                        </div>
                        <p class="scenario-narrative">{item.narrative}</p>
                        <pre class="scenario-suggestion">{item.suggestion}</pre>
                        <p class="scenario-footer">{item.footer}</p>
                      </article>
                    ))}
                  </div>
                </div>
              ) : entry.kind === 'peer' ? (
                <div class="peer-snippet">
                  <p class="peer-snippet-intro" set:html={t.peer_demo.intro} />
                  <div class="terminal">
                    <div class="terminal-header">
                      <span class="dot red"></span>
                      <span class="dot yellow"></span>
                      <span class="dot green"></span>
                      <span class="terminal-title">{t.peer_demo.title_bar}</span>
                    </div>
                    <div class="terminal-body peer-body">
                      {t.peer_demo.lines.map(line => (
                        line.kind === 'blank' ? (
                          <div class="line"><span>&nbsp;</span></div>
                        ) : line.kind === 'prompt' ? (
                          <div class="line"><span class="prompt">$</span><span class="peer-prompt">{line.text}</span></div>
                        ) : (
                          <div class="line peer-output"><span>{line.text}</span></div>
                        )
                      ))}
                    </div>
                  </div>
                </div>
              ) : (
                <div class="showcase-frame">
                  <div class="browser-chrome">
                    <span class="dot red"></span>
                    <span class="dot yellow"></span>
                    <span class="dot green"></span>
                    <span class="browser-url">localhost:14318</span>
                  </div>
                  <div class="showcase-frame__body">
                    {entry.video ? (
                      <div class="showcase-media-stack">
                        <img class="theme-img showcase-still"
                          data-dark-src={entry.dark}
                          data-light-src={entry.light}
                          src={entry.dark}
                          alt={`TMA1 Dashboard — ${c.title}`}
                          loading="lazy" width={entry.w} height={entry.h} />
                        <video class="showcase-video" muted playsinline
                          width={entry.w} height={entry.h}>
                          <source src={entry.video} type="video/mp4" />
                        </video>
                      </div>
                    ) : (
                      <img class="theme-img"
                        data-dark-src={entry.dark}
                        data-light-src={entry.light}
                        src={entry.dark}
                        alt={`TMA1 Dashboard — ${c.title}`}
                        loading="lazy" width={entry.w} height={entry.h} />
                    )}
                  </div>
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>
    {t.features.cards[7] && (
      <div class="feature-standalone">
        <div class="feature-icon">{t.features.cards[7].num}</div>
        <h3>{t.features.cards[7].title}</h3>
        <p set:html={t.features.cards[7].desc} />
      </div>
    )}
  </section>

  <section id="how-it-works" class="how-it-works">
    <p class="section-kicker">{t.how.kicker}</p>
    <h2 class="section-title">{t.how.title}</h2>
    <p class="section-desc">{t.how.desc}</p>
    <div class="steps">
      {t.how.steps.map(s => (
        <div class="step">
          <div class="step-num">{s.num}</div>
          <div class="step-content">
            <h3>{s.title}</h3>
            <p set:html={s.desc} />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section id="security" class="security-section">
    <p class="section-kicker">{t.security.kicker}</p>
    <h2 class="section-title">{t.security.title}</h2>
    <p class="section-desc">{t.security.desc}</p>

    <article class="security-panel">
      <h3 class="panel-title">{t.security.panel_title}</h3>
      <p class="panel-body" set:html={t.security.panel_body} />
    </article>

    <div class="protection-grid">
      {t.security.cards.map(c => (
        <article class="protection-card">
          <h4 class="protection-title">{c.title}</h4>
          <p class="protection-body" set:html={c.desc} />
        </article>
      ))}
    </div>
  </section>

  <section class="faq-section">
    <p class="section-kicker">{t.faq.kicker}</p>
    <h2 class="section-title">{t.faq.title}</h2>

    <div class="faq-list">
      {t.faq.items.map(item => (
        <article class="faq-card">
          <h3 class="faq-question">{item.q}</h3>
          <p class="faq-answer" set:html={item.a} />
        </article>
      ))}
    </div>
  </section>

  <Lightbox />
</div>

<SiteFooter lang={lang} product="tma1" links={footerLinks} tagline={t.footer.tagline} />

<style>
  .container { max-width: 960px; margin: 0 auto; padding: 0 24px; }

  /* Hero */
  .hero { padding: 80px 0 48px; }
  .hero .eyebrow {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 13px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--accent);
    margin-bottom: 16px;
  }
  .hero .hook {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 14px; color: var(--text-muted);
    max-width: 560px; line-height: 1.6;
    margin-bottom: 32px; min-height: 3.2em;
  }
  .hero .hook-cursor {
    color: var(--accent);
    animation: blink 1.2s step-end infinite;
  }
  .hero h1 {
    font-size: 56px; font-weight: 700; letter-spacing: -1.5px;
    line-height: 1.1; margin-bottom: 20px; max-width: 16ch;
  }
  .hero h1 .muted { color: var(--text-muted); }
  .hero .subtitle {
    font-size: 18px; color: var(--text-muted);
    max-width: 640px; line-height: 1.7; margin-bottom: 32px;
  }
  .hero .subtitle :global(em) {
    font-style: normal; color: var(--accent); font-weight: 600;
  }

  /* Onboarding card */
  .onboarding-card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 12px; padding: 20px 24px;
    max-width: 720px; margin-bottom: 16px;
  }
  .onboarding-label {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 11px; letter-spacing: 0.2em;
    color: var(--text-muted); margin-bottom: 12px;
  }
  .onboarding-body { display: flex; align-items: flex-start; gap: 16px; }
  .onboarding-text {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 14px; line-height: 1.6; color: var(--text); flex: 1;
  }
  .onboarding-text a {
    color: var(--text); text-decoration: underline;
    text-decoration-color: var(--text-muted); text-underline-offset: 2px;
  }
  .onboarding-text a:hover { text-decoration-color: var(--text); }
  .copy-btn {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 6px; color: var(--text-muted);
    padding: 6px 12px; cursor: pointer; font-size: 12px;
    font-family: inherit; transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0; white-space: nowrap;
  }
  .copy-btn:hover { border-color: var(--text-muted); color: var(--text); }

  /* Manual install */
  .manual-install { max-width: 720px; margin-bottom: 24px; }
  .manual-install summary {
    font-size: 13px; color: var(--text-muted);
    cursor: pointer; padding: 4px 0; margin-bottom: 8px;
  }
  .manual-install summary:hover { color: var(--text); }
  .install-terminal { margin-top: 8px; }

  /* Terminal chrome */
  .terminal {
    background: var(--terminal-bg); border: 1px solid var(--border);
    border-radius: 10px; overflow: hidden;
  }
  .terminal-header {
    display: flex; align-items: center; gap: 6px;
    padding: 10px 14px; background: var(--terminal-header);
    border-bottom: 1px solid var(--border);
  }
  .dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }
  .dot.red { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green { background: #28c840; }
  .terminal-title {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 11px; color: var(--comment); margin-left: 6px;
  }
  .terminal-body {
    padding: 16px 20px; font-family: "SF Mono", "Fira Code", monospace;
    font-size: 14px; line-height: 1.7;
  }
  .terminal-body .line {
    display: flex; align-items: baseline; gap: 8px; white-space: nowrap;
  }
  .terminal-body .prompt { color: var(--comment); user-select: none; flex-shrink: 0; }
  .terminal-body .cmd { color: var(--accent); }
  .terminal-body .arg { color: var(--purple); }
  .terminal-body .url { color: var(--blue); }
  .terminal-body .comment { color: var(--comment); font-style: italic; }

  /* Hero loop-moment terminal — the "this is what TMA1 does" demo */
  .loop-moment {
    max-width: 720px;
    margin: 8px 0 32px;
  }
  .loop-moment-body {
    padding: 16px 20px;
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 14px; line-height: 1.7;
  }
  .loop-moment .loop-line {
    display: flex; align-items: baseline; gap: 8px;
    white-space: normal;
    min-height: 1.7em;
  }
  .loop-moment .loop-line .prompt {
    color: var(--comment);
    user-select: none;
    flex-shrink: 0;
  }
  .loop-moment .loop-comment { color: var(--comment); font-style: italic; }
  .loop-moment .loop-tma1 { color: var(--text); }
  .loop-moment .loop-tma1 .tma1-tag {
    color: var(--accent); font-weight: 600;
    flex-shrink: 0; user-select: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .loop-moment .loop-line {
      opacity: 0; transform: translateY(2px);
      transition: opacity 0.4s ease-out, transform 0.4s ease-out;
    }
    .loop-moment.revealed .loop-line { opacity: 1; transform: none; }
  }

  /* Loop scenarios (inside feature row 01 — closes-loop) */
  .loop-scenarios { display: flex; flex-direction: column; gap: 16px; }
  .loop-scenarios-intro {
    font-size: 14px; color: var(--text-muted);
    line-height: 1.6; margin: 0;
  }
  .loop-scenarios-grid { display: flex; flex-direction: column; gap: 16px; }
  .scenario-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 20px;
    background: var(--bg-card);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .scenario-card:hover {
    border-color: var(--accent-border);
    box-shadow: 0 0 12px var(--accent-shadow);
  }
  .scenario-head {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 10px; gap: 12px;
  }
  .scenario-kind {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 12px; color: var(--text-muted);
    letter-spacing: 0.04em; word-break: break-all;
  }
  .scenario-severity {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 10px; font-weight: 700; letter-spacing: 0.12em;
    padding: 2px 8px; border-radius: 4px;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }
  .scenario-severity--high { color: var(--accent); border-color: var(--accent-border); }
  .scenario-severity--medium { color: var(--text-muted); }
  .scenario-narrative {
    font-size: 14px; color: var(--text);
    line-height: 1.5; margin: 0 0 12px;
  }
  .scenario-suggestion {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 13px;
    background: var(--code-bg);
    border-left: 2px solid var(--accent);
    padding: 12px 14px;
    margin: 0 0 12px;
    color: var(--text);
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
    border-radius: 0 4px 4px 0;
    overflow-x: auto;
  }
  .scenario-footer {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 11px; color: var(--text-muted);
    margin: 0; letter-spacing: 0.04em;
  }

  /* Peer-sessions snippet (inside feature row 02 — cross-agent peer) */
  .peer-snippet { display: flex; flex-direction: column; gap: 16px; }
  .peer-snippet-intro {
    font-size: 14px; color: var(--text-muted);
    line-height: 1.6; margin: 0;
  }
  .peer-body .line { white-space: normal; }
  .peer-body .peer-prompt { color: var(--accent); font-weight: 500; }
  .peer-body .peer-output { color: var(--text); }

  /* Custom showcase rows align top (skip default text padding) */
  .showcase-row--loop .showcase-text,
  .showcase-row--peer .showcase-text { padding-top: 0; }

  /* Highlights */
  .highlights { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .highlight-card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 10px; padding: 20px;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  .highlight-card:hover {
    border-color: var(--accent-border);
    box-shadow: 0 0 12px var(--accent-shadow);
    transform: translateY(-1px);
  }
  .highlight-card h3 { font-size: 15px; margin-bottom: 6px; letter-spacing: -0.02em; }
  .highlight-card p { font-size: 14px; color: var(--text-muted); line-height: 1.5; }

  /* Shared section */
  .section-kicker {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 12px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--accent); margin-bottom: 12px;
  }
  .section-kicker::before { content: "> "; }
  .section-title {
    font-size: 36px; font-weight: 700; letter-spacing: -0.8px;
    line-height: 1.15; margin-bottom: 12px;
  }
  .section-desc {
    font-size: 16px; color: var(--text-muted);
    line-height: 1.6; max-width: 640px; margin-bottom: 32px;
  }

  /* Browser-chrome shared by showcase frames */
  .browser-chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--terminal-header);
    border-bottom: 1px solid var(--border);
  }
  .browser-url {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 11px;
    color: var(--comment);
    margin-left: 8px;
    background: var(--bg);
    padding: 2px 10px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  /* Features */
  .features { padding: 60px 0; border-top: 1px solid var(--border); }
  .feature-icon {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 13px; color: var(--accent); margin-bottom: 12px;
  }

  /* Showcase Rows */
  .showcase .showcase-row:first-child { padding-top: 16px; }
  .showcase-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
    padding: 48px 0;
    border-bottom: 1px solid var(--border);
  }
  .showcase-row:last-of-type { border-bottom: none; }
  .showcase-row.flip .showcase-text { order: 2; }
  .showcase-row.flip .showcase-image { order: 1; }
  .showcase-text {
    padding-top: 48px;
  }
  .showcase-text h3 {
    font-size: 22px; font-weight: 700;
    letter-spacing: -0.03em; margin-bottom: 12px;
  }
  .showcase-text p {
    font-size: 15px; color: var(--text-muted); line-height: 1.65;
  }
  /* Dashboard preview tucked under the row-01 description, filling the
     empty left half that would otherwise leave the loop-scenarios on
     the right looking unbalanced. */
  .loop-preview { margin-top: 28px; }

  /* Screenshot frame */
  .showcase-frame {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 4px 24px var(--shadow);
    transition: box-shadow 0.3s, border-color 0.3s;
  }
  .showcase-frame:hover {
