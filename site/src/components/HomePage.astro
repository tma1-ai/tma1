---
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import type { T } from '../i18n/ui';

interface Props { t: T }
const { t } = Astro.props;
const onboarding = 'Read https://tma1.ai/SKILL.md and follow the instructions to install or upgrade TMA1 for your AI agent';
const repo = 'https://github.com/tma1-ai/tma1';
const navLinks = [
  { href: '#features', label: t.nav.features },
  { href: '#how-it-works', label: t.nav.how },
  { href: '#security', label: t.nav.security },
];
---

<SiteHeader lang={t.lang} product="tma1" links={navLinks} />
<main class="home">
  <section class="hero">
    <p class="eyebrow">TMA1 / AGENT OBSERVATORY</p>
    <h1>{t.hero.h1_1}<br /><span>{t.hero.h1_2}</span></h1>
    <p class="intro">{t.hero.subtitle}</p>
    <div class="actions">
      <a class="primary" href="#how-it-works">{t.hero.cta} <span aria-hidden="true">↗</span></a>
      <a href={repo}>GitHub <span aria-hidden="true">↗</span></a>
    </div>
    <p class="agents">Claude Code <span>·</span> Codex <span>·</span> Copilot CLI <span>·</span> OpenCode</p>
  </section>

  <figure class="overview">
    <img class="theme-img" src="/screenshots/hero-light.webp"
      data-light-src="/screenshots/hero-light.webp" data-dark-src="/screenshots/hero-dark.webp"
      alt={t.hero.overview} width="1440" height="1100" fetchpriority="high" />
    <figcaption><span>{t.hero.caption}</span><span>{t.demo}</span></figcaption>
  </figure>

  <section id="features" class="section">
    <h2>{t.features.title}</h2>
    <div class="feature-picker" aria-label={t.nav.features}>
      {t.features.cards.map((card, i) => (
        <button type="button" data-feature={card.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`feature-${card.id}`}>{card.title}</button>
      ))}
    </div>
    {t.features.cards.map((card, i) => (
      <article id={`feature-${card.id}`} class="feature-panel" hidden={i !== 0}>
        <p>{card.desc}</p>
        <a href={`/screenshots/${card.id}-light.webp`} class="screenshot-link" aria-label={card.title}>
          <img class="theme-img" src={`/screenshots/${card.id}-light.webp`}
            data-light-src={`/screenshots/${card.id}-light.webp`} data-dark-src={`/screenshots/${card.id}-dark.webp`}
            alt={card.title} width="1440" height="1000" loading="lazy" />
        </a>
      </article>
    ))}
    <details class="walkthrough">
      <summary>{t.video}</summary>
      <video controls playsinline preload="none" poster="/screenshots/sessions-light.webp" aria-label={t.video}>
        <source src="/screenshots/session-live.mp4" type="video/mp4" />
      </video>
      <p class="media-note">{t.demo}</p>
    </details>
  </section>

  <section class="section context">
    <h2>{t.context.title}</h2>
    <div class="columns">
      {t.context.cards.map(card => <article><h3>{card.title}</h3><p>{card.desc}</p></article>)}
    </div>
  </section>

  <section id="how-it-works" class="section install">
    <h2>{t.how.title}</h2>
    <p>{t.how.label}</p>
    <div class="install-command">
      <p id="onboarding-command">{onboarding}</p>
      <button type="button" id="copy-install" data-copied={t.ui.copied} data-failed={t.ui.failed}>{t.ui.copy}</button>
    </div>
    <p id="copy-status" role="status"></p>
    <details>
      <summary>{t.how.manual}</summary>
      <pre><code># macOS / Linux
curl -fsSL https://tma1.ai/install.sh | bash

# Windows (PowerShell)
irm https://tma1.ai/install.ps1 | iex</code></pre>
    </details>
    <p class="integration-note">{t.how.note}</p>
    <a href={`${repo}/blob/main/docs/opencode.md`}>{t.how.opencode}</a>
  </section>

  <section id="security" class="section privacy">
    <h2>{t.security.title}</h2>
    <p>{t.security.desc}</p>
    <a href={`${repo}#supported-sources`}>{t.security.link}</a>
  </section>
</main>
<SiteFooter lang={t.lang} product="tma1" links={[
  { href: repo, label: 'GitHub' },
  { href: `${repo}/blob/main/LICENSE`, label: 'Apache-2.0' },
]} tagline={t.footer.tagline} />

<style>
  .home { max-width: 1120px; padding: 0 32px; margin: auto; }
  .hero { padding: 80px 0 44px; }
  .eyebrow { color: var(--accent); font: 11px/1.5 monospace; letter-spacing: .14em; margin-bottom: 24px; }
  h1 { font-size: clamp(38px, 5.6vw, 68px); line-height: 1.08; font-weight: 550; letter-spacing: -.045em; }
  h1 span { color: var(--text-muted); }
  .intro { max-width: 670px; font-size: 18px; margin: 24px 0; color: var(--text-muted); }
  .actions { display: flex; align-items: center; gap: 26px; font-size: 14px; }
  .actions a { color: var(--text); }
  .actions .primary { color: var(--bg); background: var(--accent); padding: 11px 18px; border-radius: 5px; text-decoration: none; }
  .primary span { margin-left: 18px; }
  .agents { font-size: 13px; color: var(--text-muted); margin-top: 32px; }
  .agents span { padding: 0 9px; }
  img, video { display: block; width: 100%; height: auto; border: 1px solid var(--border); border-radius: 8px; }
  figcaption { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; color: var(--text-muted); margin-top: 12px; }
  .section { padding: 54px 0; border-bottom: 1px solid var(--border); scroll-margin-top: 64px; }
  h2 { font-size: clamp(24px, 3vw, 30px); line-height: 1.3; letter-spacing: -.025em; font-weight: 550; margin-bottom: 24px; }
  h3 { font-size: 16px; font-weight: 600; margin-bottom: 10px; }
  .section p { color: var(--text-muted); font-size: 15px; }
  .feature-picker { display: flex; flex-wrap: wrap; gap: 4px 18px; border-bottom: 1px solid var(--border); }
  button { font: inherit; cursor: pointer; }
  .feature-picker button { border: 0; border-bottom: 2px solid transparent; background: none; color: var(--text-muted); padding: 10px 0; font-size: 14px; }
  .feature-picker button[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); }
  .feature-panel p { max-width: 780px; min-height: 72px; padding: 20px 0; }
  .feature-panel[hidden] { display: none; }
  .screenshot-link { display: block; cursor: zoom-in; }
  .walkthrough { margin-top: 22px; }
  summary { cursor: pointer; font-size: 14px; padding: 8px 0; }
  .walkthrough video { margin-top: 16px; }
  .section .media-note { font-size: 11px; margin-top: 10px; }
  .columns { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .install-command { display: flex; align-items: center; gap: 24px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 18px 20px; margin-top: 16px; }
  .install-command p { font: 13px/1.7 monospace; overflow-wrap: anywhere; }
  .install-command button { border: 1px solid var(--border); border-radius: 4px; background: var(--bg); color: var(--text); padding: 7px 12px; flex-shrink: 0; font-size: 12px; }
  #copy-status:empty { display: none; }
  #copy-status { margin-top: 8px; }
  .install details { margin-top: 12px; }
  .integration-note { max-width: 760px; margin: 24px 0 10px; }
  .privacy p { max-width: 760px; margin-bottom: 16px; }
  .section > a { font-size: 14px; }
  :global(html[data-product="tma1"]) { --bg: #111713; --bg-card: #19211c; --border: #303c33; --text: #e7ebe5; --text-muted: #a0aea2; --accent: #8bc4a0; --terminal-header: #19211c; --code-bg: #19211c; --blue: #8bc4a0; }
  :global(html[data-product="tma1"][data-theme="light"]) { --bg: #fafbf7; --bg-card: #f0f3ec; --border: #d6ded1; --text: #233129; --text-muted: #657368; --accent: #306d4e; --terminal-header: #f0f3ec; --code-bg: #f0f3ec; --blue: #306d4e; }
  :global([data-product="tma1"] .site-nav), :global([data-product="tma1"] .product-bar-inner) { max-width: 1120px; padding-left: 32px; padding-right: 32px; }
  :global([data-product="tma1"] .cursor), :global([data-product="tma1"] .tab-cursor) { display: none; }
  @media (max-width: 600px) {
    .home { padding: 0 20px; }
    .hero { padding-top: 48px; }
    .intro { font-size: 16px; }
    .agents { line-height: 2; }
    .agents span { padding: 0 4px; }
    figcaption { flex-direction: column; gap: 4px; }
    .section { padding: 36px 0; }
    .columns { grid-template-columns: 1fr; gap: 24px; }
    .install-command { align-items: flex-start; flex-direction: column; gap: 12px; }
    :global([data-product="tma1"] .site-nav), :global([data-product="tma1"] .product-bar-inner) { padding-left: 20px; padding-right: 20px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLImageElement>('.theme-img').forEach(img => {
    img.src = (document.documentElement.dataset.theme === 'dark' ? img.dataset.darkSrc : img.dataset.lightSrc)!;
  });
  document.querySelectorAll<HTMLButtonElement>('[data-feature]').forEach(button => {
    button.addEventListener('click', () => {
      document.querySelectorAll('[data-feature]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      document.querySelectorAll<HTMLElement>('.feature-panel').forEach(panel => { panel.hidden = panel.id !== button.getAttribute('aria-controls'); });
    });
  });
  document.querySelectorAll<HTMLAnchorElement>('.screenshot-link').forEach(link => {
    link.addEventListener('click', () => { link.href = link.querySelector('img')!.src; });
  });
  const copy = document.querySelector<HTMLButtonElement>('#copy-install')!;
  copy.addEventListener('click', async () => {
    const status = document.querySelector('#copy-status')!;
    try {
      await navigator.clipboard.writeText(document.querySelector('#onboarding-command')!.textContent!.trim());
      status.textContent = copy.dataset.copied!;
    } catch {
      status.textContent = copy.dataset.failed!;
    }
  });
</script>
