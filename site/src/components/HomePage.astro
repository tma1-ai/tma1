    box-shadow: 0 4px 24px var(--shadow), 0 0 0 1px var(--accent-border);
  }
  .showcase-frame .browser-chrome { padding: 8px 12px; }
  .showcase-frame .browser-url { font-size: 10px; }
  .showcase-frame__body { line-height: 0; }
  .showcase-frame__body img, .showcase-frame__body video {
